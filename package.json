{
  "name": "mangatranslator",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first manga translation workspace with a React/Vite frontend and OpenRouter-powered translation chat.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "server": "node --no-warnings server/index.cjs",
    "start": "node --no-warnings server/index.cjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:smoke": "node scripts/smoke-test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.1",
    "jszip": "3.10.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sharp": "0.34.5",
    "streamdown": "2.5.0",
    "vite": "8.0.10"
  },
  "devDependencies": {
    "playwright": "1.59.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
